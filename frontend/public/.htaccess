# Storefront web server rules (LiteSpeed/Apache), deployed with every build
# into public_html by deploy/cpanel-deploy.sh. Edit here, never on the server.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ===== One address: https://nevanhandicraft.com.np =====
  # (/.well-known stays reachable over http for SSL certificate renewal)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ===== Per-page copies for search engines and link previews =====
  # Written by the backend (services/seoPagesService.ts) into _seo/; each is the
  # app with that page's title, description, preview image and structured data.
  # The folder itself isn't reachable directly.
  RewriteCond %{THE_REQUEST} \s/+_seo/ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{DOCUMENT_ROOT}/_seo/products/$1.html -f
  RewriteRule ^products/([^/]+)/?$ _seo/products/$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/_seo/sale/$1.html -f
  RewriteRule ^sale/([^/]+)/?$ _seo/sale/$1.html [L]

  RewriteCond %{DOCUMENT_ROOT}/_seo/pages/$1.html -f
  RewriteRule ^(products|categories|about|contact|faq|shipping|returns|privacy)/?$ _seo/pages/$1.html [L]

  # ===== SPA ROUTING FOR REACT APP =====
  # Don't rewrite files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Rewrite everything else to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Enable GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  # Always re-check pages so visitors get new releases at once
  # (the hashed files in /assets are cached for a year: assets/.htaccess)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # ===== Security headers =====
  # HSTS without includeSubDomains: other projects' subdomains share this account
  Header set Strict-Transport-Security "max-age=31536000"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # What the pages may load. Outside sources: the API and its chat socket,
  # Cloudinary photos, Google sign-in, the Google Maps embed (Contact) and the
  # eSewa payment form. 'unsafe-inline' styles: React style attributes.
  # The sha256 is the inline theme script in index.html (scripts/check-csp-hash.mjs
  # keeps it in sync). Add the Sentry ingest host to connect-src when a DSN is set.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-fow6dmVc2CwKuj/V6NaZ4vXEoLdUgbZsDR5E/YuzYBY=' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://res.cloudinary.com https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://backend.nevanhandicraft.com.np wss://backend.nevanhandicraft.com.np https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://maps.google.com https://www.google.com; form-action 'self' https://esewa.com.np https://epay.esewa.com.np https://rc-epay.esewa.com.np; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
