# Settings for deploy/cpanel-deploy.sh. Copy to ~/.nevan-deploy.env on the server
# (outside the repository, so pulls never change it) and fill in your paths:
#   cp ~/repositories/nevan/deploy/nevan-deploy.env.example ~/.nevan-deploy.env
#
# All values come from cPanel → Setup Node.js App → your backend app.

# "Application root" of the backend app (full path)
APP_ROOT=/home/CPANEL_USER/backend

# The activate script from the "Enter to the virtual environment" command shown
# at the top of the app's page: source /home/CPANEL_USER/nodevenv/backend/20/bin/activate && cd …
NODEVENV_ACTIVATE=/home/CPANEL_USER/nodevenv/backend/20/bin/activate

# Document root of nevanhandicraft.com.np (where index.html is served from)
WEB_ROOT=/home/CPANEL_USER/public_html

# Checked after the backend restarts
HEALTH_URL=https://backend.nevanhandicraft.com.np/api/v1/health
