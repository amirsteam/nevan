# Environment Variables for BivanHandicraft Backend (local development)
# Copy this file to .env and fill in your values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bivanhandicraft
MONGODB_URI=mongodb://localhost:27017/bivanhandicraft

# JWT secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin two-step login: encrypts the authenticator secrets (32 bytes, 64 hex characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in development (a key derived from JWT_ACCESS_SECRET is used); required in
# production. Changing it makes every admin set up their authenticator app again.
TWO_FACTOR_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URLs (CORS allow-list; FRONTEND_URL may be comma-separated)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=
# Socket.IO allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Backend URL (payment gateway callbacks)
BACKEND_URL=http://localhost:5000

# eSewa — public sandbox credentials from eSewa's developer docs
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti — sandbox keys from https://test-admin.khalti.com
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=

# Email (password reset codes, contact-form copies). Without SMTP_HOST, codes
# are printed to the backend console (and shown on the reset page in
# development) — nothing reaches a real inbox.
#
# Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
# Check the settings with:  npm run test-email -- you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nevan <no-reply@nevanhandicraft.com.np>"

# Sign in with Google — OAuth client IDs from Google Cloud Console (APIs & Services →
# Credentials), comma-separated: web client (also used by the mobile app), Android, iOS.
# Leave empty to turn Google sign-in off (POST /auth/google answers 503).
GOOGLE_CLIENT_IDS=

# Optional
# REDIS_URL=redis://localhost:6379   # multi-instance Socket.IO
# TRUST_PROXY=true                   # behind ngrok / a reverse proxy in development
# RATE_LIMIT_MAX=1000                # requests per IP per window (all /api routes)
# RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10             # failed logins per IP per 15 minutes
# ORDER_PAYMENT_TIMEOUT_MINUTES=30      # unpaid eSewa/Khalti orders are cancelled after this

# Error monitoring (optional) — Sentry project DSN
# SENTRY_DSN=
# API docs are served at /api/v1/docs outside production