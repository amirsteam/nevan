# Production Environment Variables (Reference for cPanel)
# Add these in cPanel -> Setup Node.js App -> Environment Variables.
# Startup file: dist/server.js (run `npm run build` first)

NODE_ENV=production
PORT=3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bivanhandicraft?retryWrites=true&w=majority

# Security — unique random values, different from development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS / Socket.IO origins
FRONTEND_URL=https://nevanhandicraft.com.np,https://www.nevanhandicraft.com.np
ALLOWED_ORIGINS=https://nevanhandicraft.com.np,https://www.nevanhandicraft.com.np
ADMIN_URL=

# Payment callbacks
BACKEND_URL=https://backend.nevanhandicraft.com.np

# Payment Gateways (live merchant credentials)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=

# Email (required in production for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nevan <no-reply@nevanhandicraft.com.np>"

# Error monitoring (optional) — Sentry project DSN
SENTRY_DSN=

# Set to true to expose Swagger UI at /api/v1/docs in production
# API_DOCS=false

# Unpaid eSewa/Khalti orders are cancelled (stock returned) after this many minutes
ORDER_PAYMENT_TIMEOUT_MINUTES=30
