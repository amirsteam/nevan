# Copy to .env.local (gitignored) and restart `npx expo start`.
# Only used in development builds; release builds always use the production API.

# Real device on the same WiFi: your computer's LAN IP (ipconfig / ifconfig)
# EXPO_PUBLIC_DEV_HOST=192.168.1.10

# Tunnel / different network: full API URL (overrides EXPO_PUBLIC_DEV_HOST)
# EXPO_PUBLIC_API_URL=https://abc123.ngrok-free.app/api/v1

# Sign in with Google (needs an EAS build — the button is hidden in Expo Go).
# The WEB client ID is the token audience the API checks; the iOS client ID is
# also turned into the iOS URL scheme by app.config.js. For EAS builds, set these
# as EAS environment variables too (they are read at build time).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def.apps.googleusercontent.com
